{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15MB",
        "runtime": "python3.11"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/auth/(.*)", "dest": "/api/index.py" },
    { "src": "/resume/(.*)", "dest": "/api/index.py" },
    { "src": "/interview/(.*)", "dest": "/api/index.py" },
    { "src": "/report/(.*)", "dest": "/api/index.py" },
    { "src": "/candidate/(.*)", "dest": "/api/index.py" },
    { "src": "/recruiter/(.*)", "dest": "/api/index.py" },
    { "src": "/coding/(.*)", "dest": "/api/index.py" },
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/", "dest": "/frontend/index.html" }
  ]
}
