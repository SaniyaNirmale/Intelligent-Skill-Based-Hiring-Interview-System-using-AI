# WCI Engine - Environment Configuration Template
# ----------------------------------------------------
# Rename this file to `.env` in this directory and fill in your chosen keys.

# MongoDB Database Connection (Recommended for cloud data persistence on Vercel)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=wci_engine

# 1. Groq Cloud API (Recommended: Extremely fast and cheap!)
# Get your key here: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 2. OpenAI API
# Get your key here: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic Claude API
# Get your key here: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
